# Copia este archivo como .env. Nunca subas .env a GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Contraseña personal para IA y sincronización. Obligatoria para exponer el servidor.
APP_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Si tu interfaz está en GitHub Pages, escribe aquí su origen SIN la ruta del repositorio:
# ALLOWED_ORIGINS=https://emsramirez-moises.github.io
ALLOWED_ORIGINS=
# En un alojamiento usa una ruta con disco persistente (la base no puede estar en un disco efímero).
DATA_DIR=./.data
